# ProctorStream environment configuration. Copy to .env and adjust. Never commit a real .env.
# (Env var prefix PROCTORSTREAM_ and default DB/user names are retained from the original codebase;
# they are internal identifiers, not user-facing product branding.)
PROCTORSTREAM_DATABASE_URL=postgresql+psycopg://proctorstream:proctorstream@localhost:5432/proctorstream
# Used only by the test suite (a separate, disposable database).
PROCTORSTREAM_TEST_DATABASE_URL=postgresql+psycopg://proctorstream:proctorstream@localhost:5432/proctorstream_test
# Local object storage root for recordings (S3-compatible backend can be swapped in later).
PROCTORSTREAM_STORAGE_ROOT=./storage
PROCTORSTREAM_DATA_ROOT=./data
# Upload limits
PROCTORSTREAM_MAX_UPLOAD_MB=1024
# Comma-separated origins allowed to call the API from a browser.
PROCTORSTREAM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Current consent form version shown to participants.
PROCTORSTREAM_CONSENT_VERSION=consent-v1.0
# Postgres credentials used by docker-compose
POSTGRES_USER=proctorstream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=proctorstream
